#: cekirdek/giris.py:32
msgid ""
"KULLANIM\n"
"  openmc-arayuz-kosu rapor <koşu_dizini> [-o rapor.pdf] [--spec model.json]\n"
"\n"
"  -o, --cikti   rapor dosyası; biçim uzantıdan (.pdf | .html).\n"
"                Verilmezse <koşu_dizini>/rapor.pdf\n"
"  --spec        modelin JSON dosyası. Verilmezse koşu dizinindeki\n"
"                spec.json ya da tukenme_spec.json okunur."
msgstr ""
"USAGE\n"
"  openmc-arayuz-kosu rapor <run_directory> [-o rapor.pdf] [--spec model.json]\n"
"\n"
"  -o, --cikti   report file; format from the extension (.pdf | .html).\n"
"                Default: <run_directory>/rapor.pdf\n"
"  --spec        JSON file of the model. Default: spec.json or\n"
"                tukenme_spec.json in the run directory."

#: cekirdek/giris.py:116
msgid ""
"KULLANIM\n"
"  openmc-arayuz-kosu uygunluk <koşu_dizini> [--profil A,B,C,D] [--siki]\n"
"\n"
"  --profil   denetim profilleri (virgülle). Verilmezse koşu dizinindeki\n"
"             spec.json'un seçimi; o da yoksa A,D.\n"
"             A Monte Carlo iyi uygulaması, B kritiklik güvenliği,\n"
"             C reaktör kor tasarımı, D raporlama.\n"
"  --siki     değerlendirilemeyen (uygulanamadı) kural da başarısızlıktır.\n"
"\n"
"  Çıkış kodu: 0 hata bulgusu yok, 1 hata bulgusu var, 2 kullanım hatası,\n"
"  3 (--siki ile) değerlendirilemeyen kural var."
msgstr ""
"USAGE\n"
"  openmc-arayuz-kosu uygunluk <run_directory> [--profil A,B,C,D] [--siki]\n"
"\n"
"  --profil   check profiles (comma-separated). Default: the selection in\n"
"             spec.json in the run directory; otherwise A,D.\n"
"             A Monte Carlo good practice, B criticality safety,\n"
"             C reactor core design, D reporting.\n"
"  --siki     a rule that cannot be evaluated (not applicable) also counts as a "
"failure.\n"
"\n"
"  Exit code: 0 no error findings, 1 error findings, 2 usage error,\n"
"  3 (with --siki) a rule could not be evaluated."

