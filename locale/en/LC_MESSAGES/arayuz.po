#: arayuz/analiz/adlar.py:62
msgid "Yakıt sıcaklığı (Doppler)"
msgstr "Fuel temperature (Doppler)"

#: arayuz/analiz/adlar.py:63
msgid "Yakıtın sıcaklığı değişir; yoğunluğu sabit tutulur (katı yakıt)."
msgstr "The fuel temperature changes; its density is held constant (solid fuel)."

#: arayuz/analiz/adlar.py:64
msgid "Soğutucu sıcaklığı"
msgstr "Coolant temperature"

#: arayuz/analiz/adlar.py:65
msgid ""
"Sıcaklıkla birlikte yoğunluk da değişir (su tablosu, Na ve Pb-Bi korelasyonları); "
"moderatör sıcaklık katsayısını verir."
msgstr ""
"Density changes with temperature (water table, Na and Pb-Bi correlations); gives the "
"moderator temperature coefficient."

#: arayuz/analiz/adlar.py:67
msgid "Soğutucu boşluğu (void)"
msgstr "Coolant void"

#: arayuz/analiz/adlar.py:68
msgid "Soğutucu yoğunluğu boşluk oranı kadar azaltılır."
msgstr "The coolant density is reduced by the void fraction."

#: arayuz/analiz/adlar.py:69
msgid "Çözünmüş bor"
msgstr "Dissolved boron"

#: arayuz/analiz/adlar.py:70
msgid "Suya doğal bor eklenir (ppm, kütlece)."
msgstr "Natural boron is added to the water (ppm by mass)."

#: arayuz/analiz/adlar.py:71
msgid "Uranyum zenginliği"
msgstr "Uranium enrichment"

#: arayuz/analiz/adlar.py:72
msgid "U-235'in ağırlıkça yüzdesi."
msgstr "Weight percent of U-235."

#: arayuz/analiz/adlar.py:73
msgid "Kontrol çubuğu daldırma"
msgstr "Control rod insertion"

#: arayuz/analiz/adlar.py:74
msgid "%0 tamamen çekilmiş, %100 tamamen dalmış."
msgstr "0% fully withdrawn, 100% fully inserted."

#: arayuz/analiz/adlar.py:75
msgid "Kontrol tamburu dönmesi"
msgstr "Control drum rotation"

#: arayuz/analiz/adlar.py:76
msgid "0° emici kora bakar (en düşük k), 180° dışa bakar (en yüksek k)."
msgstr "At 0° the absorber faces the core (lowest k), at 180° it faces outward (highest k)."

#: arayuz/analiz/adlar.py:77
msgid "Yansıtıcı kuşak kalınlığı"
msgstr "Radial reflector thickness"

#: arayuz/analiz/adlar.py:78
