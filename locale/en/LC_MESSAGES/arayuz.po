msgstr "Radial thickness of the radial reflector."

#: arayuz/analiz/adlar.py:79
msgid "Çubuk adımı (moderasyon oranı)"
msgstr "Pin pitch (moderation ratio)"

#: arayuz/analiz/adlar.py:80
msgid "Demetteki çubuk adımı; moderatör/yakıt oranını değiştirir."
msgstr "Pin pitch in the assembly; changes the moderator-to-fuel ratio."

#: arayuz/analiz/adlar.py:81
