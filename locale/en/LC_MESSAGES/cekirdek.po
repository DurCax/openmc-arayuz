#, python-format
msgid "'%s' çubuğu: son bölgenin yarıçapı boş olmalı (son bölge çubuğun dışıdır)"
msgstr ""
"pin '%s': the radius of the last pin region must be empty (the last region is outside"
" the pin)"

#: cekirdek/geometri/bilesen.py:68
#, python-format
msgid "'%s' çubuğu: bilinmeyen kesit şekli %r"
msgstr "pin '%s': unknown cross-section shape %r"

#: cekirdek/geometri/bilesen.py:88
#, python-format
msgid ""
"'%s' kontrol çubuğu 3B model gerektirir: kor yüksekliği tanımlı değil. Eksenel bir uç"
" konumu olmadan daldırma tanımlanamaz."
msgstr ""
"control rod '%s' requires a 3D model: the core height is not defined. Insertion "
"cannot be defined without an axial tip position."

#: cekirdek/geometri/bilesen.py:92
#, python-format
msgid "'%s' kontrol çubuğu: daldırma %%0–%%100 arasında olmalı (%s)"
msgstr "control rod '%s': insertion must be between 0%% and 100%% (%s)"

#: cekirdek/geometri/bilesen.py:102
#, python-format
msgid "'%s' kontrol çubuğu: geçersiz emici bölge %d"
msgstr "control rod '%s': invalid absorber region %d"

#: cekirdek/geometri/bilesen.py:179
#, python-format
msgid "'%s' demeti: harita %d satır, boyut %d bekliyor"
msgstr "assembly '%s': the map has %d rows, the size expects %d"

#: cekirdek/geometri/bilesen.py:183
#, python-format
msgid "'%s' demeti: '%s' satırı %d karakter, %d bekleniyor"
msgstr "assembly '%s': row '%s' has %d characters, %d expected"

#: cekirdek/geometri/bilesen.py:189
#, python-format
msgid "'%s' demeti: %d halka bekleniyor, haritada %d satır var"
msgstr "assembly '%s': %d rings expected, the map has %d rows"

#: cekirdek/geometri/bilesen.py:193
#, python-format
msgid "'%s' demeti: %d. halka (yarıçap %d) %d öğe bekliyor, %d var"
msgstr "assembly '%s': ring %d (radius %d) expects %d elements, has %d"

#: cekirdek/geometri/bilesen.py:196
#, python-format
msgid "bilinmeyen demet türü: %s"
msgstr "unknown assembly type: %s"

#: cekirdek/geometri/bilesen.py:199
#, python-format
msgid "'%s' demeti: haritada tanımsız harf '%s'"
msgstr "assembly '%s': undefined letter '%s' in the map"

#: cekirdek/geometri/denetim.py:69
#, python-format
msgid "Yuvada düğüm ya da ad bekleniyordu (%r)."
msgstr "A node or a name was expected in the slot (%r)."

#: cekirdek/geometri/denetim.py:76
#, python-format
msgid "Tanımsız ad: '%s' (çubuk, plaka, demet, tambur, parça ya da malzeme değil)."
msgstr ""
"Undefined name: '%s' (not a pin, plate, assembly, control drum, component or "
"material)."

#: cekirdek/geometri/denetim.py:82
#, python-format
msgid "Bilinmeyen düğüm türü: %r."
msgstr "Unknown node type: %r."

#: cekirdek/geometri/denetim.py:85
#, python-format
msgid "İç içe derinlik %d düzeyi aşıyor."
msgstr "Nesting depth exceeds %d levels."

#: cekirdek/geometri/denetim.py:88
#, python-format
msgid "İç içe derinlik %d düzeyden fazla; izleme yavaşlar."
msgstr "Nesting depth is more than %d levels; tracking slows down."

#: cekirdek/geometri/denetim.py:93
msgid "Düğüm kimliği (id) boş olmayan bir dize olmalı."
msgstr "The node ID (id) must be a non-empty string."

#: cekirdek/geometri/denetim.py:95
#, python-format
msgid "Kimlik '%s' ağaçta iki kez kullanılıyor (%s)."
msgstr "ID '%s' is used twice in the tree (%s)."

#: cekirdek/geometri/denetim.py:107
msgid "Malzeme düğümüne dönüşüm uygulanamaz: OpenMC malzeme dolgulu hücreyi döndürmez."
msgstr ""
"A transform cannot be applied to a material node: OpenMC does not rotate a material-"
"filled cell."

#: cekirdek/geometri/denetim.py:111
#, python-brace-format
msgid "Dönüşüm bir nesne olmalı: {\"donme\", \"oteleme\"}."
msgstr "A transform must be an object: {\"donme\", \"oteleme\"}."

#: cekirdek/geometri/denetim.py:114
msgid "Dönüşüm: 'donme' sayı olmalı (derece)."
msgstr "Transform: 'donme' must be a number (degrees)."

#: cekirdek/geometri/denetim.py:118
msgid "Dönüşüm: 'oteleme' [x, y] olmalı (cm)."
msgstr "Transform: 'oteleme' must be [x, y] (cm)."

#: cekirdek/geometri/denetim.py:124
#, python-format
msgid "Tanımsız malzeme: '%s'."
msgstr "Undefined material: '%s'."

#: cekirdek/geometri/denetim.py:127
#, python-format
msgid "Çözülmemiş referans '%s': kaydedilmeden önce parçaya çevrilmeliydi."
msgstr "Unresolved reference '%s': it should have been turned into a component before saving."

#: cekirdek/geometri/denetim.py:134
#, python-format
msgid "Tanımsız bileşen: '%s'."
msgstr "Undefined component: '%s'."

#: cekirdek/geometri/denetim.py:137
#, python-format
msgid "Belirsiz ad '%s': %s bölümlerinin ikisinde de var."
msgstr "Ambiguous name '%s': it exists in both %s sections."

#: cekirdek/geometri/denetim.py:139
msgid "Birini yeniden adlandırın."
msgstr "Rename one of them."

#: cekirdek/geometri/denetim.py:144
#, python-format
msgid "Döngü: '%s' parçası kendini içeriyor (%s)."
msgstr "Cycle: component '%s' contains itself (%s)."

