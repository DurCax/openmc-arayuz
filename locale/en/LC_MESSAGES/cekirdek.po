msgid_plural "%s: %.4f / %.4f (%d çubuk)"
msgstr[0] "%s: %.4f / %.4f (%d pin)"
msgstr[1] "%s: %.4f / %.4f (%d pins)"

#: cekirdek/guc_yorum.py:98
msgctxt "çoğul"
msgid "çubuk"
msgstr "pins"

#: cekirdek/guc_yorum.py:104
msgid ""
"F_q tanımsız — model 2B (eksenel yükseklik yok). Eksenel tepe olmadan yerel güç "
"yoğunluğu hesaplanamaz; Kor sekmesinde yükseklik tanımlayın."
msgstr ""
"F_q undefined — the model is 2D (no axial height). Without an axial peak the local "
"power density cannot be computed; define a height on the Geometry page."

#: cekirdek/guc_yorum.py:107
#, python-format
msgid "F_q = %.4f — yerel güç yoğunluğu tepesi (eksenel şekil dahil)."
msgstr "F_q = %.4f — local power density peak (including the axial shape)."

#: cekirdek/guc_yorum.py:111
#, python-format
msgid ""
"  Dikkat: yalnızca %d eksenel dilim var. Kaba dilimler tepeyi ortalar ve F_q'yu "
"olduğundan küçük gösterir (saf kosinüs profilinde ince dilim sınırı π/2 = 1.571'dir)."
" En az 10–20 dilim kullanın."
msgstr ""
"  Caution: there are only %d axial bins. Coarse bins average out the peak and make "
"F_q look smaller than it is (in a pure cosine profile the fine-bin limit is π/2 = "
"1.571). Use at least 10–20 bins."

#: cekirdek/guc_yorum.py:118
#, python-format
msgid ""
"  %d eksenel dilim boş (hedef çubuk o katmanlarda yok: %s); bu dilimler F_q "
"ortalamasına katılmadı."
msgstr ""
"  %d axial bins are empty (the target pin is absent from those layers: %s); these "
"bins were excluded from the F_q average."

#: cekirdek/guc_yorum.py:123
msgid "(çubuk, dilim) çifti"
msgstr "(pin, slice) pairs"

#: cekirdek/guc_yorum.py:129
msgid "  Yüksek: tipik PWR sınırı F_q ≈ 2.3–2.6."
msgstr "  High: the typical PWR limit is F_q ≈ 2.3–2.6."

#: cekirdek/guc_yorum.py:138
#, python-format
