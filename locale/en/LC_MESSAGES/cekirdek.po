#: cekirdek/dogrula/geometri.py:112
msgid "Kontrol malzemeleri genellikle B4C, Ag-In-Cd, Gd2O3 ya da Hf içerir."
msgstr "Control materials usually contain B4C, Ag-In-Cd, Gd2O3 or Hf."

#: cekirdek/dogrula/geometri.py:118
msgid "izleyici malzeme seçilmemiş — çubuk çekildiğinde yeri boş (madde yok) kalır"
msgstr "no follower material selected — when the rod is withdrawn its place stays empty (void)"

#: cekirdek/dogrula/geometri.py:119
msgid ""
"Çekilen çubuğun yerini genellikle soğutucu doldurur; bilerek boş bırakılacaksa 'Boş "
"(madde yok)' seçin."
msgstr ""
"The place of a withdrawn rod is usually filled by coolant; if it is deliberately left"
" empty, select 'Void (no material)'."

#: cekirdek/dogrula/geometri.py:122
#, python-format
