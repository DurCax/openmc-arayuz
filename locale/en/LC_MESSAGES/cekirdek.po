#: cekirdek/dogrula/agac.py:49
#, python-format
msgid "Geometri gezilemedi: %s"
msgstr "Geometry could not be traversed: %s"

#: cekirdek/dogrula/agac.py:52
#, python-format
msgid "Geometri gezilemedi (beklenmeyen hata, ayrıntı günlükte): %s"
msgstr "Geometry could not be traversed (unexpected error, details in the log): %s"

#: cekirdek/dogrula/agac.py:113
#, python-format
msgid "'%s' deliği bölgesinden taşıyor (dış sınıra değiyor)."
msgstr "Hole '%s' extends beyond its region (touches the outer boundary)."

#: cekirdek/dogrula/agac.py:114
msgid "Merkez yarıçapını ya da delik ölçüsünü küçültün."
msgstr "Reduce the centre radius or the hole size."

#: cekirdek/dogrula/agac.py:117
#, python-format
msgid "'%s' deliği bölgenin iç sınırına taşıyor."
msgstr "Hole '%s' extends into the inner boundary of the region."

#: cekirdek/dogrula/agac.py:118
msgid "Merkez yarıçapını büyütün ya da deliği küçültün."
msgstr "Increase the centre radius or reduce the hole."

#: cekirdek/dogrula/agac.py:130
#, python-format
msgid "'%s' deliği kafes konumu hücresinden taşıyor."
msgstr "Hole '%s' extends beyond its lattice position cell."

#: cekirdek/dogrula/agac.py:131
msgid "Delik konum hücresinin içinde kalmalı (kafes adımından küçük)."
msgstr "The hole must stay inside its position cell (smaller than the lattice pitch)."

#: cekirdek/dogrula/agac.py:154
#, python-format
msgid "'%s' ve '%s' delikleri örtüşüyor."
msgstr "Holes '%s' and '%s' overlap."

#: cekirdek/dogrula/agac.py:156
msgid "Örtüşen hücreler kayıp parçacık üretir; yerleşimleri ayırın."
msgstr "Overlapping cells produce lost particles; separate the placements."

#: cekirdek/dogrula/agac.py:178
#, python-format
msgid "%d kesik konum/bileşen üst bölgeyle kırpılıyor (ilk %d: %s)."
msgstr "%d truncated positions/components are clipped by the parent region (first %d: %s)."

#: cekirdek/dogrula/agac.py:180
msgid ""
"Kırpılan bileşenin hacmi stokastik hesaplanır; güç haritasında 'kesik' olarak "
"işaretlenir."
msgstr ""
"The volume of a clipped component is computed stochastically; it is marked "
"'truncated' in the power map."

#: cekirdek/dogrula/agac.py:184
#, python-format
msgid "%d kesik çubuk: pin bölgesi hücre sınırıyla kesiliyor (ilk %d: %s)."
msgstr "%d truncated pins: the pin region is cut by the cell boundary (first %d: %s)."

#: cekirdek/dogrula/agac.py:186
msgid ""
"Kesik çubuk F_ΔH'ye girmez ve hacmi stokastik hesaplanır; çubuk çubuk yanmada HATA "
"verir."
msgstr ""
"A truncated pin is excluded from F_ΔH and its volume is computed stochastically; pin-"
"by-pin burnup gives an ERROR."

#: cekirdek/dogrula/agac.py:191
#, python-format
msgid "%d kafes konumu tamamen gizli (delik altında): haritada '.' yazılabilir."
msgstr "%d lattice positions are fully hidden (under a hole): '.' can be written in the map."

#: cekirdek/dogrula/agac.py:210
#, python-format
msgid ""
"Altıgen '%s' demeti altıgen kafes elemanında aynı yönelimle ('%s'); demet elemana "
"oturmaz."
msgstr ""
"Hexagonal assembly '%s' has the same orientation ('%s') as the hexagonal lattice "
"element; the assembly does not fit the element."

#: cekirdek/dogrula/agac.py:212
msgid "Demet yönelimi kafes yönelimine dik olmalı: ters(kafes.yonelim)."
msgstr ""
"The assembly orientation must be perpendicular to the lattice orientation: "
"opposite(lattice.orientation)."

#: cekirdek/dogrula/agac.py:226
#, python-format
msgid ""
"'%s' plaka elemanı bulunduğu bölgeyi doldurmuyor (%.4g × %.4g cm; bölge %.4g cm²): "
"aradaki nokta tanımsız (kayıp parçacık)."
msgstr ""
"Plate-type fuel element '%s' does not fill its region (%.4g × %.4g cm; region %.4g "
"cm²): the points in between are undefined (lost particles)."

#: cekirdek/dogrula/agac.py:229
msgid "Plaka elemanını ölçüsüne eşit bir kafes konumuna ya da kaba koyun."
msgstr "Place the plate-type fuel element in a lattice position or container of equal size."

#: cekirdek/dogrula/agac.py:246
msgid "2B modelde eksenel yığın kurulamaz; kök yüksekliği verin."
msgstr "An axial stack cannot be built in a 2D model; give the root a height."

#: cekirdek/dogrula/agac.py:252
#, python-format
msgid "0 cm katman atlandı: %s"
msgstr "0 cm layer skipped: %s"

#: cekirdek/dogrula/agac.py:255
#, python-format
msgid "Kök dışındaki eksenel yığının toplamı (%g cm) model yüksekliğine (%g cm) eşit değil."
msgstr ""
"The sum of the axial stack outside the root (%g cm) is not equal to the model height "
"(%g cm)."

#: cekirdek/dogrula/agac.py:273
#, python-format
msgid "'%s' yüzünde %s sınır bu dış sınırda kullanılamaz (%s)."
msgstr "%s boundary on face '%s' cannot be used on this outer boundary (%s)."

#: cekirdek/dogrula/agac.py:275
msgid ""
"Periyodik sınır yalnız dikdörtgen/altıgen dış sınırda ve sınıra değen delik yokken "
"kullanılabilir."
msgstr ""
"A periodic boundary can be used only on a rectangular/hexagonal outer boundary and "
"only when no hole touches the boundary."

#: cekirdek/dogrula/agac.py:280
#, python-format
msgid "%s sınır periyodik olamaz: sonlu bir korda eksenel periyodiklik fiziksel değildir."
msgstr "%s boundary cannot be periodic: axial periodicity is not physical in a finite core."

#: cekirdek/dogrula/agac.py:284 cekirdek/dogrula/kor.py:364
msgid "yükseklik verilmemiş — model eksenel yönde sonsuz (2B) kabul ediliyor"
msgstr "height not given — the model is treated as infinite in the axial direction (2D)"

#: cekirdek/dogrula/agac.py:295
msgid "Kök içinde boş (void) bölge: nötron burada etkileşmeden geçer."
msgstr "Void region inside the root: neutrons pass through it without interacting."

#: cekirdek/dogrula/agac.py:300
msgid "2B modelde kontrol tamburu: eksenel sızıntı yok; tambur değeri fazla çıkar."
msgstr ""
"Control drum in a 2D model: there is no axial leakage; the drum worth comes out too "
"high."

#: cekirdek/dogrula/agac.py:326
#, python-format
msgid ""
"Aynı içerikli iki satır içi alt ağaç ('%s'): ayrı evrenler olur, distribcell ve "
"tükenme örnekleri bölünür."
msgstr ""
"Two inline subtrees with the same content ('%s'): they become separate universes, so "
"distribcell and depletion instances are split."

#: cekirdek/dogrula/agac.py:328
msgid "Alt ağacı bir parçaya çevirip iki yerde 'bilesen' olarak kullanın."
msgstr "Turn the subtree into a component and use it in both places as a 'bilesen' node."

#: cekirdek/dogrula/agac.py:342
#, python-format
msgid "Model kurulamadı: %s"
msgstr "Model could not be built: %s"

#: cekirdek/dogrula/agac.py:345 cekirdek/dogrula/agac.py:350
#, python-format
msgid "Nokta yoklaması: %s. %s"
msgstr "Point sampling: %s. %s"

#: cekirdek/dogrula/agac.py:347 cekirdek/geometri/yoklama.py:141
msgctxt "yoklama"
msgid "örtüşme"
msgstr "overlap"

#: cekirdek/dogrula/agac.py:348
msgid "Örtüşen hücreler kayıp parçacık üretir."
msgstr "Overlapping cells produce lost particles."

#: cekirdek/dogrula/agac.py:352 cekirdek/geometri/yoklama.py:142
msgctxt "yoklama"
msgid "boşluk"
msgstr "gap"

#: cekirdek/dogrula/agac.py:353
msgid "Tanımsız bölge: parçacık kaybolur. Bölgeyi bir malzemeyle doldurun."
msgstr "Undefined region: particles are lost. Fill the region with a material."

#: cekirdek/dogrula/ayar.py:22
msgid "parçacık sayısı sıfırdan büyük olmalı"
msgstr "number of particles must be greater than zero"

#: cekirdek/dogrula/ayar.py:24
msgid "çevrim sayısı sıfırdan büyük olmalı"
msgstr "number of batches must be greater than zero"

#: cekirdek/dogrula/ayar.py:29
#, python-format
msgid "pasif çevrim (%d) toplam çevrimden (%d) az olmalı"
msgstr "inactive batches (%d) must be fewer than the total batches (%d)"

#: cekirdek/dogrula/ayar.py:33
#, python-format
msgid "pasif çevrim çok az (%d) — kaynak dağılımı yakınsamamış olabilir"
msgstr "very few inactive batches (%d) — the source distribution may not have converged"

#: cekirdek/dogrula/ayar.py:34
msgid "Tipik olarak en az 20–50 pasif çevrim kullanılır."
msgstr "Typically at least 20–50 inactive batches are used."

#: cekirdek/dogrula/ayar.py:38
#, python-format
msgid "aktif çevrim sayısı az (%d) — istatistik zayıf kalır"
msgstr "few active batches (%d) — the statistics remain weak"

#: cekirdek/dogrula/ayar.py:43
msgid "Shannon entropisi kapalı — kaynak dağılımının yakınsayıp yakınsamadığı ölçülemez"
msgstr "Shannon entropy is off — source convergence cannot be measured"

#: cekirdek/dogrula/ayar.py:45
msgid ""
"Yakınsamamış kaynak k-eff'i yanlı tahmin ettirir ve bu başka türlü fark edilmez. "
"Özdeğer hesaplarında açık tutun."
msgstr ""
"An unconverged source biases the k-eff estimate, and this is not noticed in any other"
" way. Keep it on in eigenvalue calculations."

#: cekirdek/dogrula/ayar.py:49
msgid "entropi ağı boyutları sıfırdan büyük olmalı"
msgstr "entropy mesh dimensions must be greater than zero"

#: cekirdek/dogrula/ayar.py:53
#, python-format
msgid "çevrim başına parçacık az (%d) — kaynak yakınsaması bozulabilir"
msgstr "few particles per batch (%d) — source convergence may suffer"

#: cekirdek/dogrula/eksenel.py:44
#, python-format
msgid "eksenel katmanlar '%s' kor türünde desteklenmiyor"
msgstr "axial layers are not supported for core type '%s'"

#: cekirdek/dogrula/eksenel.py:45
#, python-format
msgid ""
"Destekleyen türler: %s. Küresel düzenekte eksen kavramı yoktur; orada katmanı eş "
"merkezli kabuklarla kurun."
msgstr ""
"Supported types: %s. A spherical assembly has no axis; build the layers there as "
"concentric shells."

#: cekirdek/dogrula/eksenel.py:53
msgid "eksenel katmanlar açık ama hiç katman tanımlı değil"
msgstr "axial layers are on but no layer is defined"

#: cekirdek/dogrula/eksenel.py:58
msgid "adsız"
msgstr "unnamed"

#: cekirdek/dogrula/eksenel.py:61
msgid "katman yüksekliği sıfırdan büyük olmalı"
msgstr "layer height must be greater than zero"

#: cekirdek/dogrula/eksenel.py:65
#, python-format
msgid "aynı ad birden fazla katmanda kullanılmış: '%s'"
msgstr "the same name is used in more than one layer: '%s'"

#: cekirdek/dogrula/eksenel.py:71
#, python-format
msgid "tanımsız dolgu adı: '%s'"
msgstr "undefined fill name: '%s'"

#: cekirdek/dogrula/eksenel.py:72
msgid "Dolgu bir çubuk, plaka elemanı, demet ya da malzeme adı olmalı."
msgstr "The fill must be the name of a pin, plate-type fuel element, assembly or material."

#: cekirdek/dogrula/eksenel.py:80
msgid ""
"katmana özel harf eşlemesi yalnızca kare haritalı tam korda ya da altıgen haritalı "
"tam korda kullanılabilir"
msgstr ""
"a layer-specific letter mapping can be used only in a full core with a rectangular or"
" hexagonal map"

#: cekirdek/dogrula/eksenel.py:86
#, python-format
msgid "'%s' harfi kor haritasında hiç geçmiyor"
msgstr "letter '%s' does not occur in the core map"

#: cekirdek/dogrula/eksenel.py:89
#, python-format
msgid "tanımsız demet/malzeme adı: '%s'"
msgstr "undefined assembly/material name: '%s'"

#: cekirdek/dogrula/eksenel.py:95
#, python-format
msgid ""
"eksenel katmanlar açıkken yükseklik alanı (%g cm) yok sayılır; geçerli yükseklik "
"katmanların toplamıdır (%g cm)"
msgstr ""
"with axial layers on, the height field (%g cm) is ignored; the effective height is "
"the sum of the layers (%g cm)"

#: cekirdek/dogrula/eksenel.py:119
msgid "hiçbir eksenel katmanda fisil malzeme yok — özdeğer koşusu başlangıç kaynağı bulamaz"
msgstr ""
"no axial layer contains fissile material — the eigenvalue run cannot find an initial "
"source"

#: cekirdek/dogrula/eksenel.py:124
#, python-format
msgid "aktif yakıt yüksekliği %g cm / toplam %g cm (z = %g … %g)"
msgstr "active fuel height %g cm / total %g cm (z = %g … %g)"

#: cekirdek/dogrula/eksenel.py:126
msgid ""
"Başlangıç kaynağı kutusu ve kontrol çubuğu daldırması bu fisil aralığa göre "
"tanımlıdır. Güç dağılımının eksenel ağı ise hedef çubuğun bulunduğu aralığa göre — "
"ikisi aynı olmak zorunda değil (doğal uranyum örtü fisildir ama içinde yakıt çubuğu "
"yoktur)."
msgstr ""
"The initial source box and the control rod insertion are defined relative to this "
"fissile range. The axial mesh of the power distribution, however, follows the range "
"of the target pin — the two need not be the same (a natural uranium blanket is "
"fissile but contains no fuel pin)."

#: cekirdek/dogrula/eksenel.py:154
#, python-format
msgid "fisil aralık %g cm ama '%s' çubuğu yalnızca %g cm boyunca var"
msgstr "the fissile range is %g cm but pin '%s' is present over only %g cm"

#: cekirdek/dogrula/eksenel.py:156
msgid ""
"Güç dağılımı yalnızca bu çubuğu sayar; toplam güç ise tüm modelin gücüdür. Aradaki "
"fisil katmanların (örtü gibi) gücü de bu çubuklara paylaştırılmış olur ve W/cm "
"olduğundan yüksek çıkar. Mutlak sayıları kullanacaksanız toplam gücü yalnızca bu "
"çubukların ürettiği güç olarak girin."
msgstr ""
"The power distribution counts only this pin, whereas the total power is the power of "
"the whole model. The power of the fissile layers in between (such as a blanket) is "
"also shared among these pins, so W/cm comes out too high. If you will use absolute "
"values, enter as total power only the power produced by these pins."

#: cekirdek/dogrula/eksenel.py:165
msgid "kontrol çubuğu daldırması aktif yakıt aralığında ölçülür"
msgstr "the control rod insertion is measured over the active fuel range"

#: cekirdek/dogrula/eksenel.py:166
msgid "%0 = uç aktif bölgenin tepesinde, %100 = dibinde; modelin toplam yüksekliği değil."
msgstr ""
"0% = tip at the top of the active region, 100% = at its bottom; not the total height "
"of the model."

#: cekirdek/dogrula/geometri.py:22
msgid "plaka sayısı"
msgstr "number of plates"

#: cekirdek/dogrula/geometri.py:22
msgid "yakıt (et) kalınlığı"
msgstr "fuel (meat) thickness"

#: cekirdek/dogrula/geometri.py:23
msgid "zarf kalınlığı"
msgstr "cladding thickness"

#: cekirdek/dogrula/geometri.py:23
msgid "soğutucu kanalı kalınlığı"
msgstr "coolant channel thickness"

#: cekirdek/dogrula/geometri.py:24
msgid "plaka genişliği"
msgstr "plate width"

#: cekirdek/dogrula/geometri.py:27
msgid "yakıt (et) malzemesi"
msgstr "fuel (meat) material"

#: cekirdek/dogrula/geometri.py:27
msgid "zarf malzemesi"
msgstr "cladding material"

#: cekirdek/dogrula/geometri.py:28
msgid "soğutucu"
msgstr "coolant"

#: cekirdek/dogrula/geometri.py:44
msgid "en az iki bölge gerekir (iç bölge + dış dolgu)"
msgstr "at least two pin regions are required (inner region + outer fill)"

#: cekirdek/dogrula/geometri.py:48
msgid "son bölgenin yarıçapı boş olmalı"
msgstr "the radius of the last pin region must be empty"

#: cekirdek/dogrula/geometri.py:49
msgid "Son bölge çubuğun dışıdır ve hücrenin geri kalanını doldurur."
msgstr "The last region is outside the pin and fills the rest of the cell."

#: cekirdek/dogrula/geometri.py:54
#, python-format
msgid "%d. bölgenin yarıçapı sıfırdan büyük olmalı: %s"
msgstr "the radius of pin region %d must be greater than zero: %s"

#: cekirdek/dogrula/geometri.py:60
#, python-format
msgid "yarıçaplar artan sırada olmalı: r%d = %.5f ≥ r%d = %.5f"
msgstr "radii must be in increasing order: r%d = %.5f ≥ r%d = %.5f"

#: cekirdek/dogrula/geometri.py:68
#, python-format
msgid "%d. bölgenin malzemesi seçilmemiş"
msgstr "no material selected for pin region %d"

#: cekirdek/dogrula/geometri.py:69
msgid "Bir malzeme seçin; bölge bilerek boş bırakılacaksa 'Boş (madde yok)' seçin."
msgstr ""
"Select a material; if the region is deliberately left empty, select 'Void (no "
"material)'."

