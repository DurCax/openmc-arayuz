#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:47
#, python-format
msgid ""
"USL hesaplanamadı (%s). k = %s bir alt-kritiklik sınırıyla karşılaştırılmadı; bu "
"sonuç kritiklik güvenliği kanıtı değildir."
msgstr ""
"USL could not be computed (%s). k = %s was not compared with a subcritical limit; "
"this result is not evidence of criticality safety."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:54
#, python-format
msgid "k + %gσ = %.5f < USL = %.5f."
msgstr "k + %gσ = %.5f < USL = %.5f."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:55
#, python-format
msgid "k + %gσ = %.5f, USL = %.5f: kabul koşulu sağlanmıyor."
msgstr "k + %gσ = %.5f, USL = %.5f: the acceptance condition is not met."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:57
msgid ""
"Sistem alt-kritiklik ölçütünü karşılamıyor; tasarımı ya da denetim parametrelerini "
"değiştirin."
msgstr ""
"The system does not meet the subcriticality criterion; change the design or the "
"control parameters."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:68
msgid ""
"Uygulamanın kategorik AOA özellikleri (bölünebilir element, fiziksel biçim, "
"yansıtıcı, tayf) verilmedi."
msgstr ""
"The categorical AOA properties of the application (fissile element, physical form, "
"reflector, spectrum) were not given."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:75
#, python-format
msgid "%s: %s kümede var."
msgstr "%s: %s is present in the set."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:78
#, python-format
msgid ""
"%s: uygulama '%s', doğrulama kümesi yalnız %s içeriyor — uygulanabilirlik alanının "
"dışında."
msgstr ""
"%s: application '%s', the validation set contains only %s — outside the area of "
"applicability."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:80
msgid "Bu özelliği taşıyan kriter deneyleri kümeye ekleyin."
msgstr "Add benchmark experiments with this property to the set."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:90
#, python-format
msgid "USL'de pozitif yanlılık (%+.5f) kredilendirilmiş."
msgstr "A positive bias (%+.5f) is credited in the USL."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:92
msgid "Yanlılık > 0 ise USL hesabında 0 alınmalıdır."
msgstr "If the bias is > 0, it must be taken as 0 in the USL calculation."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:93
#, python-format
msgid "Kullanılan yanlılık %+.5f (ham %+.5f); pozitif yanlılık kredilendirilmedi."
msgstr "Bias used %+.5f (raw %+.5f); positive bias not credited."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:102
msgid "Kriter k_exp ≠ 1 olan vakalar k_calc / k_exp ile normalleştirilmemiş."
msgstr "Cases with benchmark k_exp ≠ 1 are not normalized with k_calc / k_exp."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:104
msgid "k_norm = k_calc / k_exp ve σ = √(σ_calc² + σ_exp²) kullanın."
msgstr "Use k_norm = k_calc / k_exp and σ = √(σ_calc² + σ_exp²)."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:106
msgid "k_calc / k_exp normalleştirmesi uygulandı."
msgstr "k_calc / k_exp normalization applied."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:116
#, python-format
msgid "Kümede %d vaka (< %d): teknik gerekçe gerekli."
msgstr "%d cases in the set (< %d): a technical justification is required."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:118
msgid "Kümeye bağımsız kriter deneyleri ekleyin."
msgstr "Add independent benchmark experiments to the set."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:120
#, python-format
msgid "Kümede %d vaka."
msgstr "%d cases in the set."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:124
msgid "Parametrik olmayan yöntemde güven düzeyi (β) bildirilmemiş."
msgstr "The confidence level (β) of the non-parametric method is not reported."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:129
#, python-format
msgid "β = %%%.1f ≤ %%%.0f iken USL verilmiş; ek veri gerekir, USL hesaplanamaz."
msgstr ""
"A USL is given while β = %.1f%% ≤ %.0f%%; additional data are required, the USL "
"cannot be computed."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:138
msgid "doğrulama kümesi"
msgstr "validation set"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:140
msgid "profil"
msgstr "profile"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:142
msgid "Alt-kritik pay (ΔSM) tanımlı değil."
msgstr "Margin of subcriticality (ΔSM) is not defined."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:144
#, python-format
msgid "ΔSM = %.3f (%s) mutlak alt sınırın (%.2f) altında: profil geçersiz."
msgstr "ΔSM = %.3f (%s) is below the absolute lower limit (%.2f): the profile is invalid."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:146
#, python-format
msgid "ΔSM'yi en az %.2f yapın ve gerekçesini yazın."
msgstr "Set ΔSM to at least %.2f and write down its justification."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:147
#, python-format
msgid "ΔSM = %.3f (%s) ≥ %.2f; seçilen değerin gerekçesi kullanıcı kuruluşa aittir."
msgstr ""
"ΔSM = %.3f (%s) ≥ %.2f; the justification of the chosen value belongs to the user "
"organization."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:165
#, python-format
msgid "%s = %g doğrulama aralığında [%g, %g]."
msgstr "%s = %g is within the validation range [%g, %g]."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:166
#, python-format
msgid "%s = %g doğrulama aralığının [%g, %g] dışında (taşma %%%.0f)."
msgstr "%s = %g is outside the validation range [%g, %g] (excess %.0f%%)."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:169
msgid "Tolerans sınırı yöntemi dış değerleme için kullanılamaz."
msgstr "The tolerance limit method cannot be used for extrapolation."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:171
msgid "Tolerans bandı yöntemini kullanın ya da kümeyi genişletin."
msgstr "Use the tolerance band method or extend the set."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:173
msgid "Doğrulama kümesi genişletilmeli."
msgstr "The validation set must be extended."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:175
msgid "Dış değerleme için ΔAOA payı ve gerekçesi girilmeli."
msgstr "For extrapolation a ΔAOA margin and its justification must be entered."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:177
#, python-format
msgid "ΔAOA = %.3f uygulandı."
msgstr "ΔAOA = %.3f applied."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:186
msgid "Uygulamanın sayısal AOA parametreleri (zenginlik, H/X, EALF…) verilmedi."
msgstr ""
"The numerical AOA parameters of the application (enrichment, H/X, EALF…) were not "
"given."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:197
msgid "Normallik testi sonucu raporlanmamış."
msgstr "The result of the normality test is not reported."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:200
#, python-format
msgid "Veri normal değil (%s) ama '%s' yöntemi kullanılmış."
msgstr "The data are not normal (%s) but the '%s' method was used."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:203
msgid "Parametrik olmayan yöntem zorunludur."
msgstr "A non-parametric method is required."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:206
msgid "Normallik sonucu yöntemle tutarlı."
msgstr "The normality result is consistent with the method."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:210
#, python-format
msgid "Anlamlı eğilim var (%s) ama tolerans sınırı yöntemi kullanılmış."
msgstr "There is a significant trend (%s) but the tolerance limit method was used."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:212
msgid "Eğilim varsa tolerans bandı yöntemini kullanın."
msgstr "If there is a trend, use the tolerance band method."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:215
msgid "Eğilim analizi sonucu raporlanmamış."
msgstr "The result of the trend analysis is not reported."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:218
msgid "Eğilim sonucu yöntemle tutarlı."
msgstr "The trend result is consistent with the method."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:229
#, python-format
msgid ""
"Aynı deney serisinden birden çok vaka: %s. Vakalar bağımsız değil; istatistik güveni "
"abartılı olabilir."
msgstr ""
"More than one case from the same experiment series: %s. The cases are not "
"independent; the statistical confidence may be overstated."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:231
msgid "Her deney serisinden en çok bir vaka."
msgstr "At most one case from each experiment series."

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:235
msgid "Kabul koşulu k + 2σ < USL"
msgstr "Acceptance condition k + 2σ < USL"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:237
msgid "Uygulanabilirlik alanı (kategorik)"
msgstr "Area of applicability (categorical)"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:239
msgid "Pozitif yanlılık kredilendirilmez"
msgstr "Positive bias is not credited"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:241
msgid "k_calc / k_exp normalleştirmesi"
msgstr "k_calc / k_exp normalization"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:243
msgid "Vaka sayısı ve güven düzeyi"
msgstr "Number of cases and confidence level"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:245
msgid "Alt-kritik pay ΔSM ≥ 0.02"
msgstr "Margin of subcriticality ΔSM ≥ 0.02"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:247
msgid "Doğrulama aralığı dışına dış değerleme"
msgstr "Extrapolation outside the validation range"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:249
msgid "Eğilim ve normallik"
msgstr "Trend and normality"

#: cekirdek/uygunluk_denetimi/kurallar_kritiklik.py:251
msgid "Deneyler arası bağımsızlık"
msgstr "Independence between experiments"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:29
#, python-format
msgid "Statepoint okunamadı: %s"
msgstr "Statepoint could not be read: %s"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:30
msgid "Koşuyu yeniden çalıştırın."
msgstr "Run the calculation again."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:32
msgid "Koşu dizininde statepoint yok."
msgstr "There is no statepoint in the run directory."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:34
msgid "Sabit kaynak koşusu: k-eff ve kaynak yakınsaması tanımsız."
msgstr "Fixed source run: k-eff and source convergence are undefined."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:49
msgid "Shannon entropisi kapalı — kaynak yakınsaması gösterilemiyor."
msgstr "Shannon entropy is off — source convergence cannot be shown."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:51
msgid "Hesap ayarlarında entropi ağını açın."
msgstr "Turn on the entropy mesh in the run settings."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:60
msgid "Pasif çevrim sayısını entropi platosu başlayana dek artırın."
msgstr "Increase the number of inactive batches until the entropy plateau begins."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:74
#, python-format
msgid "σ hedefi tanımlı değil; k = %.5f, σ = %.5f (1σ) karşılaştırılmadı."
msgstr "No σ target defined; k = %.5f, σ = %.5f (1σ) not compared."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:76
msgid "Profil A'da sigma_hedef eşiğini girin."
msgstr "Enter the sigma_hedef threshold in profile A."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:78
#, python-format
msgid "σ_k = %.5f hedefin (%.5f) üstünde."
msgstr "σ_k = %.5f is above the target (%.5f)."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:80
msgid "Aktif çevrim ya da çevrim başı parçacık sayısını artırın."
msgstr "Increase the number of active batches or particles per batch."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:82
#, python-format
msgid "σ_k = %.5f ≤ hedef %.5f."
msgstr "σ_k = %.5f ≤ target %.5f."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:91
#, python-format
msgid ""
"Çevrim başına %d parçacık: k-eff ve yerel tally'lerde yanlılık beklenir (alt sınır "
"%d)."
msgstr ""
"%d particles per batch: bias is expected in k-eff and in local tallies (lower limit "
"%d)."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:93
msgid "Çevrim başı parçacık sayısını artırın."
msgstr "Increase the number of particles per batch."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:97
#, python-format
msgid ""
"Çevrim başına %d parçacık: deneme koşusu için yeterli; uzun üretim koşusunda en az %d"
" önerilir."
msgstr ""
"%d particles per batch: sufficient for a trial run; at least %d is recommended for a "
"long production run."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:100
#, python-format
msgid "Çevrim başına %d parçacık."
msgstr "%d particles per batch."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:109
#, python-format
msgid "Aktif çevrim alt sınırı tanımlı değil (%d aktif çevrim)."
msgstr "No lower limit for active batches defined (%d active batches)."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:112
#, python-format
msgid "%d aktif çevrim, alt sınır %d."
msgstr "%d active batches, lower limit %d."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:114
msgid "Çevrim sayısını artırın."
msgstr "Increase the number of batches."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:115
#, python-format
msgid "%d aktif çevrim ≥ %d."
msgstr "%d active batches ≥ %d."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:145
msgid "Çevrim k değerleri ilinti için yetersiz."
msgstr "Too few batch k values for the correlation."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:150
#, python-format
msgid ""
"Çevrimler arası ilinti belirgin (gecikme-1 r = %.2f > %.2f): bildirilen σ bu ilintiyi"
" yok sayar ve gerçek belirsizliği küçümser (%s §IV.A). Kaynak, yerel tally'lerde "
"(fisyon hızları) 1.7–4.7 kat küçümseme ölçer (§IV.B Tablo 2); k-eff için büyüklük "
"vermez."
msgstr ""
"The batch-to-batch correlation is significant (lag-1 r = %.2f > %.2f): the reported σ"
" ignores this correlation and underestimates the true uncertainty (%s §IV.A). The "
"source measures an underestimation by a factor of 1.7–4.7 in local tallies (fission "
"rates) (§IV.B Table 2); it gives no magnitude for k-eff."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:155
msgid "Bağımsız tohumlarla birkaç koşu yapıp sonuçların saçılımını karşılaştırın."
msgstr "Make several runs with independent seeds and compare the spread of the results."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:157
#, python-format
msgid "Gecikme-1 ilinti r = %.2f ≤ %.2f."
msgstr "Lag-1 correlation r = %.2f ≤ %.2f."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:177
#, python-format
msgid "OpenMC hata iletisi: %s"
msgstr "OpenMC error message: %s"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:182
#, python-format
msgid "OpenMC %d uyarı yazdı (kayıp parçacık dışı): %s"
msgstr "OpenMC wrote %d warnings (other than lost particles): %s"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:184
msgid "Uyarıların sonucu etkileyip etkilemediğini koşu logunda inceleyin."
msgstr "Check in the run log whether the warnings affect the result."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:193
msgid "Koşu logu (kosu.log) yok: kayıp parçacık sayısı denetlenemedi."
msgstr "No run log (kosu.log): the number of lost particles could not be checked."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:194
msgid "Koşuyu bu uygulamayla yeniden çalıştırın; log koşu dizinine yazılır."
msgstr ""
"Run the calculation again with this application; the log is written to the run "
"directory."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:200
#, python-format
msgid "%d kayıp parçacık (izin verilen %d). %s"
msgstr "%d lost particles (%d allowed). %s"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:202
msgid ""
"Geometride boşluk ya da çakışan hücre var: kesit çizimlerini ve sınır koşullarını "
"denetleyin."
msgstr ""
"The geometry contains a gap or overlapping cells: check the geometry plots and the "
"boundary conditions."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:205
msgid "Koşu logu yok; kayıp parçacık yeniden başlatma dosyası da yok."
msgstr "No run log; no lost particle restart files either."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:208
msgid "Kayıp parçacık yok."
msgstr "No lost particles."

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:213
msgid "Kaynak yakınsaması (Shannon entropisi platosu)"
msgstr "Source convergence (Shannon entropy plateau)"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:214
msgid "iyi uygulama; "
msgstr "good practice; "

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:214
msgid " §II; NUREG/CR-6698 §2.4 dipnotu (yakınsama kullanıcı yargısıdır)"
msgstr " §II; NUREG/CR-6698 §2.4 footnote (convergence is a user judgement)"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:217
msgid "İstatistik yeterliliği"
msgstr "Statistical adequacy"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:218
msgid "iyi uygulama; eşik standarttan gelmez (profil değeri)"
msgstr "good practice; the threshold does not come from a standard (profile value)"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:220
msgid "Kayıp parçacık = 0"
msgstr "Lost particles = 0"

#: cekirdek/uygunluk_denetimi/kurallar_mc.py:221
msgid "iyi uygulama (OpenMC)"
msgstr "good practice (OpenMC)"

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:34
msgid "BIPM SI Broşürü"
msgstr "BIPM SI Brochure"

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:35
msgid "BIPM SI Broşürü 9. baskı"
msgstr "BIPM SI Brochure, 9th edition"

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:84
msgid "pcm = Δk × 10⁵ (k farkı; reaktivite farkı değildir)"
msgstr "pcm = Δk × 10⁵ (a k difference; not a reactivity difference)"

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:85
msgid "pcm = Δρ × 10⁵, ρ = (k − 1)/k; iki durum arasında Δρ = (k₂ − k₁)/(k₁·k₂)"
msgstr "pcm = Δρ × 10⁵, ρ = (k − 1)/k; between two states Δρ = (k₂ − k₁)/(k₁·k₂)"

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:141
msgid ""
"'±' ile verilen değerlerin standart belirsizlik (1σ) olduğu yazılmamış; güven aralığı"
" sanılabilir."
msgstr ""
"It is not stated that values given with '±' are standard uncertainties (1σ); they may"
" be mistaken for confidence intervals."

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:143
msgid "Belirsizliğin 1σ standart belirsizlik olduğunu yazın."
msgstr "State that the uncertainty is the 1σ standard uncertainty."

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:147
#, python-format
msgid "Belirsizlik %d anlamlı rakamdan fazla: %s"
msgstr "Uncertainty has more than %d significant digits: %s"

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:148
#, python-format
msgid "Örnek biçim: %s"
msgstr "Example format: %s"

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:152
#, python-format
msgid "Değer belirsizlikle aynı ondalık basamağa yuvarlanmamış: %s"
msgstr "The value is not rounded to the same decimal place as the uncertainty: %s"

#: cekirdek/uygunluk_denetimi/kurallar_rapor.py:157
#, python-format
msgid ""
"'pcm' kullanılmış ama tanımı (Δk × 10⁵ mi Δρ × 10⁵ mi) o bölümde ya da belge başında "
"yazılmamış: %s"
msgstr ""
"'pcm' is used but its definition (Δk × 10⁵ or Δρ × 10⁵) is not written in that "
"section or at the start of the document: %s"

